{
  "name": "ivd-material-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types src/server.ts",
    "setup:admin": "node --experimental-strip-types src/cli.ts admin-init",
    "seed:demo": "node --experimental-strip-types src/cli.ts seed-demo",
    "test:smoke": "node src/test-runner.mjs tsx src/smoke.ts",
    "test:ai-smoke": "node src/test-runner.mjs tsx src/ai-smoke.ts",
    "test:ai-contract": "node src/test-runner.mjs tsx src/ai-contract-smoke.ts",
    "test:report-knowledge": "node src/test-runner.mjs tsx src/report-knowledge-smoke.ts",
    "test:literature-smoke": "node src/test-runner.mjs tsx src/literature-smoke.ts",
    "test:literature-scope": "node src/test-runner.mjs tsx src/literature-scope-smoke.ts",
    "test:literature-worker-smoke": "node src/test-runner.mjs tsx src/literature-worker-smoke.ts",
    "test:literature-qdrant": "node src/test-runner.mjs tsx src/literature-qdrant-smoke.ts",
    "test:literature-index": "node src/test-runner.mjs tsx src/literature-index-smoke.ts",
    "test:embedding-contract": "node src/test-runner.mjs tsx src/embedding-contract-smoke.ts",
    "test:ai-worker-health": "node src/test-runner.mjs strip src/ai-worker-health-smoke.ts",
    "test:migration": "node src/test-runner.mjs strip src/migration-smoke.ts",
    "test:isolation": "node src/test-runner.mjs mjs src/test-isolation-smoke.mjs",
    "ai:worker": "node --experimental-strip-types src/ai-worker.ts",
    "report-knowledge:worker": "node --experimental-strip-types src/report-knowledge-worker.ts",
    "literature:worker": "node --experimental-strip-types src/literature-worker.ts",
    "restore:backup": "node --experimental-strip-types src/restore.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@qdrant/js-client-rest": "1.20.0",
    "archiver": "^5.3.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "1.3.27",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
