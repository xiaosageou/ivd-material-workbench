NODE_ENV=production
PORT=3001
DATA_DIR=/app/data
COOKIE_SECURE=false
# 可选：由部署管理员提供给独立 AI Worker；留空时 AI 任务保持等待配置。
IVD_AI_API_KEY=
# 可选：文献与研发报告知识索引共用此服务端 Embedding 密钥；地址、模型和维度在管理员“文献向量化”设置中配置。
IVD_EMBEDDING_API_KEY=
# 可选：Qdrant 单节点保护密钥；Compose 内部 Qdrant 服务也会使用此值。
QDRANT_API_KEY=
# HTTPS profile: set DOMAIN and COOKIE_SECURE=true, then use --profile https.
# DOMAIN=ivd.example.org
