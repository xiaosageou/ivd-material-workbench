NODE_ENV=production
PORT=3001
# Compose 将数据卷 ivd-data 挂载到 /app/data；密钥及数据库保存在该卷中。
DATA_DIR=/app/data
COOKIE_SECURE=false
# 可选后备密钥；也可在网页填写，本地保存的密钥优先。
IVD_AI_API_KEY=
# 可选后备密钥；文献与报告共用，也可在网页填写。
IVD_EMBEDDING_API_KEY=
# 可选：Qdrant 单节点保护密钥；Compose 内部 Qdrant 服务也会使用此值。
QDRANT_API_KEY=
# HTTPS profile: set DOMAIN and COOKIE_SECURE=true, then use --profile https.
# DOMAIN=ivd.example.org
